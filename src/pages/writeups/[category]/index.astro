---
/**
 * Category listing: /writeups/<category>/ → write-ups tagged with that category.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { CATEGORY_IDS, getCategory, type CategoryId } from '../../../lib/taxonomy';
import { formatDate } from '../../../lib/utils';

export async function getStaticPaths() {
  const entries = await getCollection('write-ups');

  return CATEGORY_IDS.filter((id) =>
    entries.some((entry) => entry.data.category === id)
  ).map((category) => ({
    params: { category },
    props: {
      entries: entries
        .filter((entry) => entry.data.category === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

type Props = { entries: CollectionEntry<'write-ups'>[] };

const { entries } = Astro.props;
const category = getCategory(Astro.params.category as CategoryId);
---

<Layout
  title={`${category.label} | Write-ups | Cybersecurity Portfolio`}
  description={category.description}
>
  <section class="min-h-[30vh] flex items-center justify-center mb-12">
    <div class="text-center space-y-6">
      <div class="text-left inline-block">
        <p class="text-term-green/70 text-sm mb-2">
          <span class="text-cyan-400">&gt;</span>
          <span class="text-term-dim">$</span> find ~/writeups/ -wholename "*{category.id}*"
        </p>
        <h1 class="text-4xl md:text-5xl font-bold">
          <span class="text-cyan-400">{category.label}</span>
        </h1>
      </div>
      <div class="text-term-green/70 animate-pulse text-2xl">_</div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto mb-12">
    <div class="border border-cyan-500/30 bg-black/30 p-6 rounded-lg mb-8">
      <p class="text-term-green/90 leading-relaxed">{category.description}</p>
      <p class="text-term-dim text-sm mt-3">
        <span class="text-term-amber">$</span> {category.command}
      </p>
    </div>

    <div class="space-y-4">
      {
        entries.map((entry) => (
          <a
            href={`../${entry.id}/`}
            class="block border border-cyan-500/30 hover:border-cyan-400 bg-black/30 hover:bg-cyan-500/5 p-5 rounded-lg transition-all"
          >
            <div class="flex flex-col sm:flex-row justify-between gap-3">
              <div>
                <h2 class="text-term-green font-bold mb-1">{entry.data.title}</h2>
                <p class="text-term-green/70 text-sm">{entry.data.description}</p>
              </div>
              <span class="text-term-dim text-sm shrink-0 whitespace-nowrap">
                {formatDate(entry.data.pubDate)}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
