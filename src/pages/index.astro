---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../lib/taxonomy';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const featured = (await getCollection('write-ups'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Home | Cybersecurity Portfolio"
  description="Rens Schuil — cybersecurity student at HvA Amsterdam. Red teaming, Active Directory attacks, web exploitation chaining, malware analysis and SIEM engineering write-ups."
>
  <!-- Hero Section -->
  <section class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center space-y-6">
      <!-- Terminal-style prompt -->
      <div class="text-left inline-block">
        <p class="text-green-400/70 text-sm mb-2">$ whoami</p>
        <h1 class="text-4xl md:text-6xl font-bold">
          <span class="text-cyan-400">Rens Schuil</span>
        </h1>
        <p class="text-xl md:text-2xl text-green-400 mt-4">
          Cybersecurity Student @ <span class="text-cyan-400">HvA Amsterdam</span>
        </p>
      </div>

      <!-- Blinking Cursor Effect -->
      <div class="text-green-400/70 animate-pulse text-2xl">_</div>

      <!-- Quick Links -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center pt-6 px-4">
        <a 
          href="/cyber-portfolio/projects" 
          class="px-6 py-3 border border-cyan-500 text-cyan-400 hover:bg-cyan-500/10 hover:shadow-lg hover:shadow-cyan-500/20 transition-all rounded text-center whitespace-nowrap"
        >
          [View Projects]
        </a>
        <a 
          href="/cyber-portfolio/contact" 
          class="px-6 py-3 border border-green-500 text-green-400 hover:bg-green-500/10 hover:shadow-lg hover:shadow-green-500/20 transition-all rounded text-center whitespace-nowrap"
        >
          [Contact Me]
        </a>
      </div>
    </div>
  </section>

  <!-- About Me Section -->
  <section class="max-w-4xl mx-auto py-12">
    <div class="border border-cyan-500/30 bg-black/30 p-8 rounded-lg">
      <h2 class="text-2xl font-bold text-cyan-400 mb-6">
        <span class="text-green-400">&gt;</span> cat about.txt
      </h2>
      
      <div class="space-y-4 text-green-400/90 leading-relaxed">
        <p class="border-l-2 border-cyan-500/50 pl-4">
          I am a passionate Cybersecurity student at HvA Amsterdam, specializing in 
          <span class="text-red-400 font-semibold">Red Teaming</span> and 
          <span class="text-cyan-600 font-semibold">Offensive Security</span>
        </p>
        
        <p class="border-l-2 border-cyan-500/50 pl-4">
          My focus is on adversarial emulation, exploit development, privilege escalation, 
          and evasion techniques. I enjoy penetration testing, vulnerability discovery, 
          crafting custom payloads, and breaking security controls to identify weaknesses before attackers do.
        </p>

        <p class="border-l-2 border-cyan-500/50 pl-4">
          Through hands-on projects and lab environments, I've developed skills in:
        </p>

        <ul class="list-none space-y-2 pl-4">
          <li class="text-green-400"><span class="text-cyan-400">→</span> AD Security: Identity Hijacking & NTLM Relay</li>
          <li class="text-green-400"><span class="text-cyan-400">→</span> Web Exploit Chaining: SQLi to Remote Code Execution</li>
          <li class="text-green-400"><span class="text-cyan-400">→</span> Post-Exploitation: Privilege Escalation & Root Takeover</li>
          <li class="text-green-400"><span class="text-cyan-400">→</span> Behavioral Malware Analysis & TTP Mapping</li>
          <li class="text-green-400"><span class="text-cyan-400">→</span> Adaptive Threat Detection & SIEM Engineering</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Competency Categories — driven by src/lib/taxonomy.ts -->
  <section class="max-w-6xl mx-auto py-12">
    <h2 class="text-2xl font-bold text-cyan-400 mb-8 text-center">
      <span class="text-term-green">&gt;</span> ls ~/competencies
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        CATEGORIES.map((category) => (
          <a
            href={`${base}writeups/${category.id}/`}
            class="group border border-cyan-500/30 hover:border-cyan-400 bg-black/30 hover:bg-cyan-500/5 p-6 rounded-lg transition-all"
          >
            <h3 class="text-lg font-bold text-cyan-400 group-hover:text-cyan-300 transition-colors mb-2">
              {category.label}
            </h3>
            <p class="text-term-green/70 text-sm mb-4">{category.description}</p>
            <p class="text-term-amber/80 text-xs group-hover:text-term-amber transition-colors">
              $ {category.command}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Featured Write-ups -->
  <section class="max-w-4xl mx-auto py-12">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-bold text-cyan-400">
        <span class="text-term-green">&gt;</span> head -n 3 featured.log
      </h2>
      <a href={`${base}writeups/`} class="text-sm text-cyan-400 hover:text-cyan-300 transition-colors whitespace-nowrap">
        [All write-ups]
      </a>
    </div>

    <div class="space-y-4">
      {
        featured.map((entry) => (
          <a
            href={`${base}writeups/${entry.id}/`}
            class="block border border-cyan-500/30 hover:border-cyan-400 bg-black/30 hover:bg-cyan-500/5 p-5 rounded-lg transition-all"
          >
            <div class="flex flex-col sm:flex-row justify-between gap-3">
              <div>
                <h3 class="text-term-green font-bold mb-1">{entry.data.title}</h3>
                <p class="text-term-green/70 text-sm">{entry.data.description}</p>
              </div>
              <span class="text-term-dim text-sm shrink-0 whitespace-nowrap">
                {entry.data.tools.length > 0 ? entry.data.tools.join(' · ') : 'lab report'}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Terminal Command Decoration -->
  <div class="text-center py-8 text-green-400/50 text-sm">
    <p>$ ls -la ~/writeups --structured</p>
  </div>
</Layout>

<style>
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
</style>
