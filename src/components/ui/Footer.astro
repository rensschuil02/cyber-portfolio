---
/**
 * Global footer — thin, terminal-flavored, zero interactivity.
 */
---

<footer class="border-t border-cyan-500/30 bg-black/50 backdrop-blur-sm mt-auto">
  <div class="container mx-auto px-4 py-6">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-term-green/70">
        <span class="text-cyan-400">&gt;</span> Built with <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cyan-400 hover:text-cyan-300 transition-colors">Astro</a
        > &amp; Tailwind CSS
      </p>
      <p class="text-sm text-term-green/70">
        © {new Date().getFullYear()} | Cybersecurity Student @ <a
          href="https://www.amsterdamuas.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cyan-400 hover:text-cyan-300 transition-colors">HvA Amsterdam</a
        >
      </p>
    </div>
  </div>
</footer>
